# Atlas Terminal (frontend) — copy to .env.local and adjust. Never commit real secrets.

# Backend base URL the Next.js BFF calls (server-side only, loopback).
# In GitHub Codespaces keep this on 127.0.0.1:8000 — do not point at the
# public https://*-8000.app.github.dev URL from the Next server.
ATLAS_BACKEND_URL=http://127.0.0.1:8000

# Dashboard seed credentials are consumed by the FastAPI user store.
# Kept here for local tooling parity; login itself is backend-authoritative.
ATLAS_DASHBOARD_USER=admin
ATLAS_DASHBOARD_PASSWORD=atlas

# HMAC secret used to verify session cookies. MUST match the backend value.
ATLAS_AUTH_SECRET=atlas-dev-secret-change-me

# Forwarded to FastAPI mutating routes (kill-switch, cycle run, etc.).
ADMIN_API_TOKEN=local-dev-admin-token

# Enables safer login diagnostics in the BFF JSON body (no secrets).
APP_ENV=development
