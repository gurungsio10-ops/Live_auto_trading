# Atlas Terminal (frontend) — copy to .env.local and adjust. Never commit real secrets.

# Backend base URL the Next.js proxy routes call (server-side only).
ATLAS_BACKEND_URL=http://127.0.0.1:8000

# Dashboard sign-in credentials (server-side only, never sent to the browser).
# Defaults are admin / atlas when unset so the dashboard works out of the box.
ATLAS_DASHBOARD_USER=admin
ATLAS_DASHBOARD_PASSWORD=atlas

# HMAC secret used to sign session cookies. Set a strong random value in real deployments.
ATLAS_AUTH_SECRET=atlas-dev-secret-change-me
