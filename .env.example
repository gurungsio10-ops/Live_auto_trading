# Project Atlas — copy to .env and fill in. Never commit real secrets.
APP_NAME=Project Atlas
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Safety — keep paper unless you know exactly what you are doing.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
KILL_SWITCH_ENABLED=false
EXCHANGE_ENV=paper
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
LIVE_APPROVAL_TOKEN=

# Local admin token for mutating /api/v1 system endpoints (kill switch, paper reset).
# Required for those routes. Do not reuse production secrets.
ADMIN_API_TOKEN=local-dev-admin-token

DATABASE_URL=sqlite+aiosqlite:///./atlas.db
REDIS_URL=redis://localhost:6379/0
MARKET_DATA_STALE_SECONDS=30
WEBHOOK_ALERT_URL=

# Paper execution
PAPER_STARTING_BALANCE=10000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5
ALLOWED_SYMBOLS=BTC/USDT

# Risk (whole percent points OR fractions; 1 and 0.01 both mean 1%)
RISK_PER_TRADE_PERCENT=1
MAX_POSITION_PERCENT=25
MAX_DAILY_LOSS_PERCENT=3
MAX_DRAWDOWN_PERCENT=10
MAX_OPEN_POSITIONS=3

# Frontend / auth (optional local defaults — change in any shared environment)
ATLAS_AUTH_SECRET=
ATLAS_ADMIN_USERNAME=admin
ATLAS_ADMIN_PASSWORD=atlas
