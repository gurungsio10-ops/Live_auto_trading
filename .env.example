# Project Atlas — copy to .env and fill in. Never commit real secrets.
APP_NAME=Project Atlas
APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
KILL_SWITCH_ENABLED=false
EXCHANGE_ENV=paper
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
DATABASE_URL=sqlite+aiosqlite:///./atlas.db
REDIS_URL=redis://localhost:6379/0
MARKET_DATA_STALE_SECONDS=30
LIVE_APPROVAL_TOKEN=
WEBHOOK_ALERT_URL=
LOG_LEVEL=INFO
