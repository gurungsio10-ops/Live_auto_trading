# Project Atlas — copy to .env and fill in. Never commit real secrets.
APP_NAME=Project Atlas
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# PAPER TRADING MVP — live money is hard-blocked
# ---------------------------------------------------------------------------
ATLAS_RUNTIME_MODE=PAPER
TRADING_MODE=paper
TRADING_ENABLED=false
ENABLE_LIVE_TRADING=false
KILL_SWITCH_ENABLED=false

# Continuous paper loop (still paper-only; never live money)
ENABLE_TRADING_SCHEDULER=false
PAPER_CYCLE_INTERVAL_SECONDS=60
USE_LIVE_MARKET_DATA=false
ENABLE_RECONCILIATION=true
RECONCILIATION_INTERVAL_SECONDS=120
CYCLE_LOCK_FAIL_CLOSED=true
CYCLE_LOCK_TTL_SECONDS=120
ENABLE_OPS_SSE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exchange (public market data via CCXT; no keys required for OHLCV)
EXCHANGE_NAME=bybit
EXCHANGE_TESTNET=true
# Legacy aliases still accepted:
# EXCHANGE_ID=bybit
# EXCHANGE_ENV=testnet
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
LIVE_APPROVAL_TOKEN=
LIVE_STARTUP_ACK=

DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=5m
# Comma-separated symbols (NOT JSON). Example: BTC/USDT or BTC/USDT,ETH/USDT
ALLOWED_SYMBOLS=BTC/USDT

# Paper account
STARTING_BALANCE=10000
# Legacy alias: PAPER_STARTING_BALANCE=10000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5

# Risk (whole percent points OR fractions)
MAX_POSITION_RISK_PERCENT=1
MAX_POSITION_SIZE_PERCENT=20
MAX_DAILY_LOSS_PERCENT=3
MAX_DRAWDOWN_PERCENT=10
MAX_OPEN_POSITIONS=3

# Baseline EMA+RSI strategy
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21
RSI_PERIOD=14
STOP_LOSS_PERCENT=1
TAKE_PROFIT_PERCENT=2

# Local admin token for mutating control endpoints
ADMIN_API_TOKEN=local-dev-admin-token

DATABASE_URL=sqlite+aiosqlite:///./atlas.db
REDIS_URL=redis://localhost:6379/0
MARKET_DATA_STALE_SECONDS=30
ORDER_COOLDOWN_SECONDS=0
WEBHOOK_ALERT_URL=

# Frontend / auth
ATLAS_AUTH_SECRET=atlas-dev-secret-change-me
ATLAS_DASHBOARD_USER=admin
ATLAS_DASHBOARD_PASSWORD=atlas
# Next.js server-side only (loopback). Do NOT use the public Codespaces
# forwarded backend URL here — browser traffic stays same-origin via /api/*.
ATLAS_BACKEND_URL=http://127.0.0.1:8000
# Codespaces: see docs/operations/codespaces.md (scripts/codespaces_start.sh)
# codespaces_start.sh forces Compose Postgres/Redis URLs at runtime.
