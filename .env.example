# Project Atlas — copy to .env and fill in. Never commit real secrets.
APP_NAME=Project Atlas
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Runtime modes: BACKTEST | PAPER | TESTNET | LIVE
# Prefer ATLAS_RUNTIME_MODE. Invalid values fall back to PAPER (never LIVE).
# LIVE remains hard-blocked even with credentials.
# ---------------------------------------------------------------------------
ATLAS_RUNTIME_MODE=PAPER
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
# Legacy alias still accepted:
# LIVE_TRADING_ENABLED=false
KILL_SWITCH_ENABLED=false
EXCHANGE_ENV=paper
# EXCHANGE_ENV=testnet  # Binance Spot Testnet only (not live money)
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
LIVE_APPROVAL_TOKEN=
# Required acknowledgement if attempting LIVE (still hard-blocked in this phase):
LIVE_STARTUP_ACK=

# Local admin token for mutating /api/v1 system endpoints (kill switch, paper reset).
ADMIN_API_TOKEN=local-dev-admin-token

DATABASE_URL=sqlite+aiosqlite:///./atlas.db
REDIS_URL=redis://localhost:6379/0
MARKET_DATA_STALE_SECONDS=30
# Seconds between orders (0 = disabled; set 5+ for soak).
ORDER_COOLDOWN_SECONDS=0
WEBHOOK_ALERT_URL=

# Paper execution
PAPER_STARTING_BALANCE=10000
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=5
ALLOWED_SYMBOLS=BTC/USDT

# Risk (whole percent points OR fractions; 1 and 0.01 both mean 1%)
RISK_PER_TRADE_PERCENT=1
MAX_POSITION_PERCENT=25
MAX_DAILY_LOSS_PERCENT=3
MAX_DRAWDOWN_PERCENT=10
MAX_OPEN_POSITIONS=3

# Frontend / auth — names must match the backend auth store
ATLAS_AUTH_SECRET=atlas-dev-secret-change-me
ATLAS_DASHBOARD_USER=admin
ATLAS_DASHBOARD_PASSWORD=atlas
# Frontend Next.js
ATLAS_BACKEND_URL=http://127.0.0.1:8000
